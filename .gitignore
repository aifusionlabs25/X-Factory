*.py[cod]
*.lock
*.wal
*.db
*.sqlite
*.sqlite3
*.tmp
*.temp
tmp/
temp/
.cache/
**/.npm-cache/
**/node_modules/

# Recovery artifacts are stored outside this repository.
*.zip
*.tar
*.tar.gz
checkpoint-output/
