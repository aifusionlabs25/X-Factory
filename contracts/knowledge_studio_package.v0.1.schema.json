{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-fusion-labs.local/contracts/knowledge_studio_package.v0.1.schema.json",
  "title": "OMNARA Knowledge Studio Package v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mission_id", "status", "specialist", "mode", "input_binding", "entries", "files", "quality", "authority", "package_sha256"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "mission_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{3,95}$"},
    "status": {"const": "CURATED_KNOWLEDGE_BANK_READY_LOCAL_CANDIDATE"},
    "specialist": {"const": "OMNARA"},
    "mode": {"const": "ARIA_CONTROLLED_KNOWLEDGE_ENGINEERING_SIDECAR"},
    "input_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_bundle_sha256", "source_entry_ids", "source_entry_count"],
      "properties": {
        "source_bundle_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "source_entry_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "source_entry_count": {"type": "integer", "minimum": 1, "maximum": 200}
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entry_id", "kind", "category", "title", "statement", "aliases", "source_entry_ids", "source_statement_sha256", "transformation", "source"],
        "properties": {
          "entry_id": {"type": "string"},
          "kind": {"enum": ["FAQ", "POLICY", "CAPABILITY", "REFERENCE"]},
          "category": {"enum": ["COMPANY_OVERVIEW", "SERVICES", "SERVICE_AREA", "APPROVED_FAQS", "POLICIES_AND_BOUNDARIES", "QUALIFICATION", "ESCALATION", "GLOSSARY"]},
          "title": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "aliases": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "source_entry_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "source_statement_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "transformation": {"enum": ["EXACT_NORMALIZED", "TITLE_NORMALIZATION", "LIST_TO_CUSTOMER_ANSWER", "MARKETING_NEUTRALIZATION", "MULTIPARAGRAPH_CONDENSATION"]},
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file", "file_sha256", "line_start", "line_end"],
            "properties": {
              "file": {"type": "string"},
              "file_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "line_start": {"type": "integer", "minimum": 1},
              "line_end": {"type": "integer", "minimum": 1}
            }
          }
        }
      }
    },
    "files": {"type": "object", "minProperties": 3, "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_entries_preserved", "curated_entries_traceable", "unsupported_facts_added", "duplicate_entry_ids", "customer_answers_present"],
      "properties": {
        "source_entries_preserved": {"const": true},
        "curated_entries_traceable": {"const": true},
        "unsupported_facts_added": {"const": 0},
        "duplicate_entry_ids": {"const": 0},
        "customer_answers_present": {"const": true}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_calls", "network_calls", "self_approval", "source_mutation", "deployment_authorized", "production_approved"],
      "properties": {
        "provider_calls": {"const": 0},
        "network_calls": {"const": 0},
        "self_approval": {"const": false},
        "source_mutation": {"const": false},
        "deployment_authorized": {"const": false},
        "production_approved": {"const": false}
      }
    },
    "package_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
