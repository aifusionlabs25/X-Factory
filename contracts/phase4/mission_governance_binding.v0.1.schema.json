{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aifusionlabs.local/contracts/phase4/mission_governance_binding.v0.1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "governed_run_marker", "mission_id", "disclosure_manifest_sha256", "owner_approval_sha256", "broker_run_record", "evidence_approvals"],
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}},
  "properties": {
    "schema_version": {"const": "0.1"},
    "governed_run_marker": {"const": "X_FACTORY_GOVERNED_RUN_V0_1"},
    "mission_id": {"const": "phase4-governed-draft-001"},
    "disclosure_manifest_sha256": {"$ref": "#/$defs/digest"},
    "owner_approval_sha256": {"$ref": "#/$defs/digest"},
    "broker_run_record": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "governed_run_marker", "execution_mode", "mission_id", "disclosure_manifest_sha256", "owner_approval_sha256", "broker", "lifecycle_authority"],
      "properties": {
        "schema_version": {"const": "0.1"},
        "governed_run_marker": {"const": "X_FACTORY_GOVERNED_RUN_V0_1"},
        "execution_mode": {"const": "BROKERED_NO_TOOLS"},
        "mission_id": {"const": "phase4-governed-draft-001"},
        "disclosure_manifest_sha256": {"$ref": "#/$defs/digest"},
        "owner_approval_sha256": {"$ref": "#/$defs/digest"},
        "broker": {"const": "X_FACTORY_DETERMINISTIC_BROKER_V0_8"},
        "lifecycle_authority": {"const": "CONTAINED_DRAFT_ONLY"}
      }
    },
    "evidence_approvals": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["evidence_id", "artifact_sha256", "approval_record_sha256", "approval_status", "scope", "limitations"],
        "properties": {
          "evidence_id": {"type": "string", "pattern": "^EVD-[A-Z0-9-]+$"},
          "artifact_sha256": {"$ref": "#/$defs/digest"},
          "approval_record_sha256": {"$ref": "#/$defs/digest"},
          "approval_status": {"const": "APPROVED_FOR_CONTAINED_FIXTURE_ONLY"},
          "scope": {"const": "phase4-governed-draft-001"},
          "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    }
  }
}
