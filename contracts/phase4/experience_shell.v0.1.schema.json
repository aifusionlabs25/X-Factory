{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aifusionlabs.local/contracts/phase4/experience_shell.v0.1.schema.json",
  "title": "X-Agent Experience Shell v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "presence_mode", "selection_status", "avatar", "voice", "visual_environment", "channels", "fallback", "disclosure", "integration", "authority"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "presence_mode": {"enum": ["EXISTING_ANAM", "CREATE_NEW_ANAM", "STOCK_IMAGE", "TEXT_ONLY", "UNDECIDED"]},
    "selection_status": {"enum": ["OWNER_SELECTED", "FACTORY_RECOMMENDED", "DEFERRED"]},
    "avatar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "existing_avatar_id", "creation_brief", "stock_asset_id", "display_name"],
      "properties": {
        "provider": {"enum": ["ANAM", "STOCK", "NONE"]},
        "existing_avatar_id": {"type": ["string", "null"]},
        "creation_brief": {"type": ["string", "null"]},
        "stock_asset_id": {"type": ["string", "null"]},
        "display_name": {"type": ["string", "null"]}
      }
    },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["voice_id", "style", "pace", "fallback_to_text"],
      "properties": {
        "voice_id": {"type": ["string", "null"]},
        "style": {"type": "string"},
        "pace": {"enum": ["CALM", "BALANCED", "ENERGETIC"]},
        "fallback_to_text": {"const": true}
      }
    },
    "visual_environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["background_brief", "brand_alignment", "framing"],
      "properties": {
        "background_brief": {"type": "string"},
        "brand_alignment": {"type": "string"},
        "framing": {"enum": ["PORTRAIT", "WAIST_UP", "FULL_SCENE", "IMAGE_CARD", "NONE"]}
      }
    },
    "channels": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["WEB", "MOBILE_WEB", "KIOSK", "EMBED", "TEXT_FALLBACK"]}},
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "preserve_conversation_state", "user_message"],
      "properties": {
        "mode": {"enum": ["STOCK_IMAGE_AND_TEXT", "TEXT_ONLY"]},
        "preserve_conversation_state": {"type": "boolean"},
        "user_message": {"type": "string"}
      }
    },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identify_as_ai", "visible_label", "opening_disclosure"],
      "properties": {
        "identify_as_ai": {"const": true},
        "visible_label": {"type": "string"},
        "opening_disclosure": {"type": "string"}
      }
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["connector", "agent_core_transport", "credentials_required", "compatibility_status"],
      "properties": {
        "connector": {"const": "X_LINK_ANAM_ADAPTER"},
        "agent_core_transport": {"enum": ["STREAMING_CONVERSATION", "TEXT_TURN_BRIDGE", "NOT_CONFIGURED"]},
        "credentials_required": {"type": "boolean"},
        "compatibility_status": {"enum": ["NOT_CHECKED", "COMPATIBLE", "BLOCKED"]}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_creation_authorized", "provider_mutation_authorized", "deployment_authorized", "production_approved"],
      "properties": {
        "provider_creation_authorized": {"const": false},
        "provider_mutation_authorized": {"const": false},
        "deployment_authorized": {"const": false},
        "production_approved": {"const": false}
      }
    }
  }
}
