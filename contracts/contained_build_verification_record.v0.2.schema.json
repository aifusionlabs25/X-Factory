{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aifusionlabs.local/contracts/contained_build_verification_record.v0.2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "governed_run_marker", "execution_mode", "disclosure_manifest_sha256", "payload_sha256", "evidence_catalog_sha256", "approval_sha256", "provider", "model", "profiles", "tool_policy", "runtime_preflight", "session", "artifacts", "promotion_validation", "lifecycle_status", "authority"],
  "properties": {
    "schema_version": {"const": "0.2"},
    "run_id": {"const": "contained-vera-build-verification-002"},
    "governed_run_marker": {"const": "X_FACTORY_GOVERNED_BUILD_VERIFICATION_V0_2"},
    "execution_mode": {"const": "BROKERED_NO_TOOLS"},
    "disclosure_manifest_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "payload_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "evidence_catalog_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "approval_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "provider": {"const": "openai-codex"}, "model": {"const": "gpt-5.6-luna"}, "profiles": {"const": ["vera"]}, "tool_policy": {"const": "ZERO_TOOLS_NO_MCP_NO_DESKTOP_UI"},
    "runtime_preflight": {"type": "object"},
    "session": {"type": "object", "additionalProperties": false, "required": ["session_id", "virgin_session", "tool_call_count"], "properties": {"session_id": {"type": "string", "minLength": 1}, "virgin_session": {"const": true}, "tool_call_count": {"const": 0}}},
    "artifacts": {"type": "object", "additionalProperties": false, "required": ["evaluation_sha256", "promotion_validation_sha256", "raw_verdict", "completed_at"], "properties": {"evaluation_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "promotion_validation_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "raw_verdict": {"enum": ["BUILD_VERIFIED", "REVISION_REQUIRED"]}, "completed_at": {"type": "string", "format": "date-time"}}},
    "promotion_validation": {"type": "object"},
    "lifecycle_status": {"enum": ["BUILD_VERIFIED", "REVISION_REQUIRED", "VERIFICATION_ARTIFACT_INVALID"]},
    "authority": {"type": "object", "additionalProperties": false, "required": ["verification_only", "install_to_live_factory_authorized", "deployment_authorized", "production_approved"], "properties": {"verification_only": {"const": true}, "install_to_live_factory_authorized": {"const": false}, "deployment_authorized": {"const": false}, "production_approved": {"const": false}}}
  }
}
