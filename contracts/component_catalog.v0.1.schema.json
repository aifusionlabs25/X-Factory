{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aifusionlabs.local/contracts/component_catalog.v0.1.schema.json",
  "title": "X-Agent Component Catalog v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "components"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component_id", "name", "category", "status", "evidence_refs", "requirements_served", "dependencies", "constraints"],
        "properties": {
          "component_id": {"type": "string", "pattern": "^CMP-[A-Z0-9-]+$"},
          "name": {"type": "string"},
          "category": {"type": "string"},
          "status": {"enum": ["REUSABLE", "REFERENCE_PATTERN", "COMPATIBILITY_CHECK_REQUIRED", "NOT_APPROVED"]},
          "evidence_refs": {"type": "array", "items": {"type": "string", "pattern": "^EVD-[A-Z0-9-]+$"}, "minItems": 1},
          "requirements_served": {"type": "array", "items": {"type": "string"}},
          "dependencies": {"type": "array", "items": {"type": "string"}},
          "constraints": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}

