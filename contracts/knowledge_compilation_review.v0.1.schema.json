{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aifusionlabs.local/contracts/knowledge_compilation_review.v0.1.schema.json",
  "title": "X-Factory Knowledge Compilation Review v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "review_id", "package_id", "compilation_id", "status", "reviewed_at", "compilation_sha256", "decisions", "approved_count", "rejected_count", "owner_attestation", "authority", "review_sha256"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "review_id": {"type": "string", "pattern": "^kr-[a-z0-9][a-z0-9-]{2,72}$"},
    "package_id": {"type": "string", "pattern": "^kp-[a-z0-9][a-z0-9-]{2,72}$"},
    "compilation_id": {"type": "string", "pattern": "^kc-[a-z0-9][a-z0-9-]{2,72}$"},
    "status": {"enum": ["OWNER_REVIEW_COMPLETE_READY_FOR_INSTANCE_BUILD", "OWNER_REVIEW_COMPLETE_NO_APPROVED_KNOWLEDGE"]},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "compilation_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "decisions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entry_id", "decision"],
        "properties": {
          "entry_id": {"type": "string", "pattern": "^K-[0-9]{4}$"},
          "decision": {"enum": ["APPROVE", "REJECT"]}
        }
      }
    },
    "approved_count": {"type": "integer", "minimum": 0, "maximum": 200},
    "rejected_count": {"type": "integer", "minimum": 0, "maximum": 200},
    "owner_attestation": {"type": "string", "minLength": 10, "maxLength": 500},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instance_build_input", "runtime_installation", "provider_calls", "deployment_authorized", "production_approved"],
      "properties": {
        "instance_build_input": {"const": true},
        "runtime_installation": {"const": false},
        "provider_calls": {"const": 0},
        "deployment_authorized": {"const": false},
        "production_approved": {"const": false}
      }
    },
    "review_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
