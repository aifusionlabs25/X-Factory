{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aifusionlabs.local/contracts/chassis_manifest.v0.1.schema.json",
  "title": "X-Agent Chassis Manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "chassis_id", "version", "status", "role_title", "summary", "source", "invariants", "configurable_slots", "modules", "knowledge_contract", "evaluation", "authority", "chassis_sha256"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "chassis_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"const": "LOCAL_VALIDATED_CHASSIS"},
    "role_title": {"type": "string", "minLength": 2},
    "summary": {"type": "string", "minLength": 10},
    "source": {"type": "object"},
    "invariants": {"type": "object"},
    "configurable_slots": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "modules": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "knowledge_contract": {"type": "object"},
    "evaluation": {"type": "object"},
    "authority": {"type": "object"},
    "chassis_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
