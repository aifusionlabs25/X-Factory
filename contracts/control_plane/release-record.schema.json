{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "X-Agent Release Record v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "kind": {
      "const": "release_record"
    },
    "release_id": {
      "type": "string",
      "minLength": 1
    },
    "agent_id": {
      "type": "string",
      "minLength": 1
    },
    "instance_id": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "enum": [
        "preview",
        "production"
      ]
    },
    "status": {
      "enum": [
        "prepared",
        "verified",
        "live",
        "failed",
        "rolled_back"
      ]
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "accepted_package": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "package_id": {
          "type": "string",
          "minLength": 1
        },
        "manifest": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ]
        }
      },
      "required": [
        "package_id",
        "manifest"
      ]
    },
    "anam": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "saved_persona",
            "session_config"
          ]
        },
        "persona_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "intended_config": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ]
        },
        "observed_config": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "path",
                "sha256"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "mode",
        "persona_id",
        "intended_config",
        "observed_config",
        "observed_at"
      ]
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "deployment_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "repository",
        "commit_sha",
        "deployment_id"
      ]
    },
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ]
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "pending",
            "passed",
            "failed"
          ]
        },
        "verified_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "path",
                "sha256"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "verified_at",
        "evidence"
      ]
    },
    "production_approval": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "approved_by": {
              "const": "Rob"
            },
            "approved_at": {
              "type": "string",
              "format": "date-time"
            },
            "receipt": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "path",
                "sha256"
              ]
            }
          },
          "required": [
            "approved_by",
            "approved_at",
            "receipt"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target_record_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "procedure": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ]
        },
        "test_evidence": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "path",
                "sha256"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "target_record_id",
        "procedure",
        "test_evidence"
      ]
    }
  },
  "required": [
    "schema_version",
    "kind",
    "release_id",
    "agent_id",
    "instance_id",
    "environment",
    "status",
    "recorded_at",
    "accepted_package",
    "anam",
    "application",
    "url",
    "dependencies",
    "verification",
    "production_approval",
    "rollback"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "anam": {
            "properties": {
              "mode": {
                "const": "saved_persona"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "anam": {
            "properties": {
              "persona_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "verified",
              "live"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "anam": {
            "properties": {
              "observed_config": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "path",
                  "sha256"
                ]
              },
              "observed_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          "application": {
            "properties": {
              "deployment_id": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "verification": {
            "properties": {
              "status": {
                "const": "passed"
              },
              "verified_at": {
                "type": "string",
                "format": "date-time"
              },
              "evidence": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "path",
                  "sha256"
                ]
              }
            }
          },
          "rollback": {
            "properties": {
              "test_evidence": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "path",
                  "sha256"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verification": {
            "properties": {
              "status": {
                "enum": [
                  "passed",
                  "failed"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "verification": {
            "properties": {
              "verified_at": {
                "type": "string",
                "format": "date-time"
              },
              "evidence": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "path",
                  "sha256"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "environment": {
            "const": "production"
          },
          "status": {
            "const": "live"
          }
        }
      },
      "then": {
        "properties": {
          "production_approval": {
            "type": "object"
          },
          "rollback": {
            "properties": {
              "target_record_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ]
}
