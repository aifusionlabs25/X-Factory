{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-fusion-labs.local/contracts/instance_knowledge_bundle.v0.1.schema.json",
  "title": "X-Factory Instance Knowledge Bundle v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_id", "mission_id", "status", "identity", "source_binding", "entries", "authority", "bundle_sha256"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "bundle_id": {"type": "string", "pattern": "^ikb-[a-z0-9][a-z0-9-]{3,95}$"},
    "mission_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{3,95}$"},
    "status": {"const": "LOCAL_INSTANCE_KNOWLEDGE_READY_NOT_DEPLOYED"},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_name", "role_title", "client_name"],
      "properties": {
        "agent_name": {"type": "string", "minLength": 1, "maxLength": 120},
        "role_title": {"type": "string", "minLength": 1, "maxLength": 180},
        "client_name": {"type": "string", "minLength": 1, "maxLength": 180}
      }
    },
    "source_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_id", "manifest_sha256", "approval_sha256", "compilation_id", "compilation_sha256", "review_id", "review_sha256"],
      "properties": {
        "package_id": {"type": "string"},
        "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "approval_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "compilation_id": {"type": "string"},
        "compilation_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "review_id": {"type": "string"},
        "review_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entry_id", "kind", "title", "statement", "source"],
        "properties": {
          "entry_id": {"type": "string"},
          "kind": {"enum": ["FAQ", "POLICY", "CAPABILITY", "REFERENCE"]},
          "title": {"type": "string"},
          "statement": {"type": "string"},
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file", "file_sha256", "line_start", "line_end"],
            "properties": {
              "file": {"type": "string"},
              "file_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "line_start": {"type": "integer", "minimum": 1},
              "line_end": {"type": "integer", "minimum": 1}
            }
          }
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_reviewed", "local_runtime_candidate", "runtime_installed", "provider_calls", "deployment_authorized", "production_approved"],
      "properties": {
        "owner_reviewed": {"const": true},
        "local_runtime_candidate": {"const": true},
        "runtime_installed": {"const": false},
        "provider_calls": {"const": 0},
        "deployment_authorized": {"const": false},
        "production_approved": {"const": false}
      }
    },
    "bundle_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
