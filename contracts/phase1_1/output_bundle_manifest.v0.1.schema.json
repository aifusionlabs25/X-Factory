{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aifusionlabs.local/contracts/output_bundle_manifest.v0.1.schema.json",
  "title": "Deterministic Output Bundle Manifest Contract v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_id", "manifest_filename", "canonical_order", "files", "hashing", "authority"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "contract_id": {"const": "CONTRACT-OUTPUT-BUNDLE-MANIFEST-V1"},
    "manifest_filename": {"const": "bundle.manifest.json"},
    "canonical_order": {"const": "LEXICOGRAPHIC_PATH_ASCENDING"},
    "files": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "media_type", "source_template", "required"],
        "properties": {
          "path": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]+$"},
          "media_type": {"enum": ["application/json", "text/markdown", "text/x-python"]},
          "source_template": {"type": "string", "pattern": "^TPL-[A-Z0-9-]+$"},
          "required": {"const": true}
        }
      }
    },
    "hashing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "per_file_bytes", "root_digest_record", "manifest_self_hash"],
      "properties": {
        "algorithm": {"const": "SHA-256"},
        "per_file_bytes": {"const": "HASH_EXACT_NORMALIZED_OUTPUT_BYTES"},
        "root_digest_record": {"const": "SHA256_UTF8_LINES_OF_PATH_NUL_SHA256_SORTED_BY_PATH"},
        "manifest_self_hash": {"const": "EXCLUDED_FROM_ROOT_DIGEST_RECORDED_SEPARATELY_AFTER_SERIALIZATION"}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["build_authorized", "deployment_authorized", "production_approved"],
      "properties": {
        "build_authorized": {"const": false},
        "deployment_authorized": {"const": false},
        "production_approved": {"const": false}
      }
    }
  }
}
