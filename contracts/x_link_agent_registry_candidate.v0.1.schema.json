{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aifusionlabs.local/contracts/x_link_agent_registry_candidate.v0.1.schema.json",
  "title": "X-Link Agent Registry Candidate v0.1",
  "type": "object",
  "required": ["artifact_version", "agents"],
  "additionalProperties": true,
  "properties": {
    "artifact_version": {"const": "factory-candidate-v0.1"},
    "agents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": ["slug", "name", "domain", "persona", "persona_version", "eval", "factory_authority"],
        "properties": {
          "slug": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "domain": {"type": "string"},
          "persona": {"type": "string", "minLength": 1},
          "persona_version": {"type": "string", "minLength": 1},
          "eval": {"type": "object", "required": ["default_pack"]},
          "factory_authority": {"type": "object"}
        }
      }
    }
  }
}
