  "title": "X-Link Candidate Package v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "status", "agent", "conversation", "knowledge", "capabilities", "handoff", "presence", "runtime", "authority"],
  "properties": {
