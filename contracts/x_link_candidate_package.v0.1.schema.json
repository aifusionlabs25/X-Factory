    "conversation": {"type": "object"},
    "knowledge": {"type": "object"},
    "capabilities": {"type": "object"},
    "handoff": {"type": "object"},
    "presence": {"type": "object"},
    "runtime": {"type": "object"},
    "authority": {"type": "object"}
  }
}
