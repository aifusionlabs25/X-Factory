{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aifusionlabs.local/contracts/x_agent_blueprint.v0.1.schema.json",
  "title": "Canonical X-Agent Blueprint v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "candidate_id", "owner_intent", "raw_intake", "explicit_requirements", "inferred_requirements", "assumptions", "unresolved_questions", "identity", "objectives", "conversation", "knowledge", "capabilities", "components", "tools_and_actions", "boundaries", "requirements", "evaluation_plan", "implementation_handoff", "authority"],
  "$defs": {
    "stringArray": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "component": {"type": "object", "additionalProperties": false, "required": ["component_id", "reason", "evidence_refs"], "properties": {"component_id": {"type": "string", "pattern": "^CMP-[A-Z0-9-]+$"}, "reason": {"type": "string"}, "evidence_refs": {"type": "array", "items": {"type": "string", "pattern": "^EVD-[A-Z0-9-]+$"}}}}
  },
  "properties": {
    "schema_version": {"const": "0.1"},
    "run_id": {"type": "string"},
    "candidate_id": {"type": "string"},
    "owner_intent": {"type": "string"},
    "raw_intake": {"type": "object"},
    "explicit_requirements": {"$ref": "#/$defs/stringArray"},
    "inferred_requirements": {"$ref": "#/$defs/stringArray"},
    "assumptions": {"$ref": "#/$defs/stringArray"},
    "unresolved_questions": {"type": "array", "items": {"type": "string"}, "maxItems": 3},
    "identity": {"type": "object", "additionalProperties": false, "required": ["agent_name", "client", "role", "persona", "target_users"], "properties": {"agent_name": {"type": ["string", "null"]}, "client": {"type": ["string", "null"]}, "role": {"type": "string"}, "persona": {"type": "string"}, "target_users": {"$ref": "#/$defs/stringArray"}}},
    "objectives": {"type": "object", "additionalProperties": false, "required": ["primary_job", "secondary_jobs", "success_outcomes"], "properties": {"primary_job": {"type": "string"}, "secondary_jobs": {"$ref": "#/$defs/stringArray"}, "success_outcomes": {"$ref": "#/$defs/stringArray"}}},
    "conversation": {"type": "object", "additionalProperties": false, "required": ["opening_behavior", "discovery_behavior", "response_style", "correction_behavior", "closing_behavior", "escalation_behavior"], "properties": {"opening_behavior": {"type": "string"}, "discovery_behavior": {"type": "string"}, "response_style": {"type": "string"}, "correction_behavior": {"type": "string"}, "closing_behavior": {"type": "string"}, "escalation_behavior": {"type": "string"}}},
    "knowledge": {"type": "object", "additionalProperties": false, "required": ["required_domains", "authoritative_sources", "unsupported_or_unknown_topics"], "properties": {"required_domains": {"$ref": "#/$defs/stringArray"}, "authoritative_sources": {"$ref": "#/$defs/stringArray"}, "unsupported_or_unknown_topics": {"$ref": "#/$defs/stringArray"}}},
    "capabilities": {"type": "object", "additionalProperties": false, "required": ["required", "optional", "explicitly_excluded"], "properties": {"required": {"$ref": "#/$defs/stringArray"}, "optional": {"$ref": "#/$defs/stringArray"}, "explicitly_excluded": {"$ref": "#/$defs/stringArray"}}},
    "components": {"type": "object", "additionalProperties": false, "required": ["selected", "rejected"], "properties": {"selected": {"type": "array", "items": {"$ref": "#/$defs/component"}}, "rejected": {"type": "array", "items": {"type": "object", "required": ["component_id", "reason"], "properties": {"component_id": {"type": "string"}, "reason": {"type": "string"}}}}}},
    "tools_and_actions": {"type": "object", "additionalProperties": false, "required": ["allowed", "approval_required", "prohibited"], "properties": {"allowed": {"$ref": "#/$defs/stringArray"}, "approval_required": {"$ref": "#/$defs/stringArray"}, "prohibited": {"$ref": "#/$defs/stringArray"}}},
    "boundaries": {"type": "object", "additionalProperties": false, "required": ["prohibited_claims", "prohibited_actions", "escalation_triggers"], "properties": {"prohibited_claims": {"$ref": "#/$defs/stringArray"}, "prohibited_actions": {"$ref": "#/$defs/stringArray"}, "escalation_triggers": {"$ref": "#/$defs/stringArray"}}},
    "requirements": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "statement", "source", "type", "acceptance_test"], "properties": {"id": {"type": "string", "pattern": "^REQ-[0-9]{3}$"}, "statement": {"type": "string"}, "source": {"enum": ["OWNER_EXPLICIT", "ARCHITECT_INFERRED", "EVIDENCE_DERIVED"]}, "type": {"enum": ["BEHAVIOR", "KNOWLEDGE", "CAPABILITY", "BOUNDARY", "HANDOFF", "QUALITY"]}, "acceptance_test": {"type": "string"}}}},
    "evaluation_plan": {"type": "object", "additionalProperties": false, "required": ["scenarios", "hard_rules", "semantic_rubrics"], "properties": {"scenarios": {"$ref": "#/$defs/stringArray"}, "hard_rules": {"$ref": "#/$defs/stringArray"}, "semantic_rubrics": {"$ref": "#/$defs/stringArray"}}},
    "implementation_handoff": {"type": "object", "additionalProperties": false, "required": ["runtime_target", "reusable_patterns", "new_work_required", "dependencies", "unresolved_implementation_questions"], "properties": {"runtime_target": {"type": "string"}, "reusable_patterns": {"$ref": "#/$defs/stringArray"}, "new_work_required": {"$ref": "#/$defs/stringArray"}, "dependencies": {"$ref": "#/$defs/stringArray"}, "unresolved_implementation_questions": {"$ref": "#/$defs/stringArray"}}},
    "authority": {"type": "object", "additionalProperties": false, "required": ["specification_status", "build_authorized", "deployment_authorized", "production_approved"], "properties": {"specification_status": {"enum": ["DRAFT", "FROZEN_FOR_REVIEW", "SPECIFICATION_READY_FOR_BUILD", "REVISION_REQUIRED", "BLOCKED"]}, "build_authorized": {"const": false}, "deployment_authorized": {"const": false}, "production_approved": {"const": false}}}
  }
}
