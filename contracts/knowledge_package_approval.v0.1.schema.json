{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aifusionlabs.local/contracts/knowledge_package_approval.v0.1.schema.json",
  "title": "X-Factory Knowledge Package Approval v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_id", "status", "approved_at", "manifest_sha256", "owner_attestation", "authority", "approval_sha256"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "package_id": {"type": "string", "pattern": "^kp-[a-z0-9][a-z0-9-]{2,72}$"},
    "status": {"const": "OWNER_APPROVED_FOR_COMMISSIONING"},
    "approved_at": {"type": "string", "format": "date-time"},
    "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "owner_attestation": {"type": "string", "minLength": 10, "maxLength": 500},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commissioning_attachment", "runtime_compilation", "provider_calls", "deployment_authorized", "production_approved"],
      "properties": {
        "commissioning_attachment": {"const": true},
        "runtime_compilation": {"const": false},
        "provider_calls": {"const": 0},
        "deployment_authorized": {"const": false},
        "production_approved": {"const": false}
      }
    },
    "approval_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
