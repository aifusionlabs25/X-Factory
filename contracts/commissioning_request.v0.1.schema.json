{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aifusionlabs.local/contracts/commissioning_request.v0.1.schema.json",
  "title": "X-Agent Commissioning Request v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["purpose", "x_agent_name", "client_name", "personality", "target_users", "client_context", "presence_mode"],
  "properties": {
    "purpose": {"type": "string", "minLength": 10, "maxLength": 3000},
    "x_agent_name": {"type": "string", "minLength": 2, "maxLength": 80},
    "client_name": {"type": "string", "minLength": 2, "maxLength": 160},
    "personality": {"type": "string", "minLength": 2, "maxLength": 1000},
    "target_users": {"type": "string", "minLength": 2, "maxLength": 1000},
    "client_context": {"type": "string", "maxLength": 4000},
    "additional_requirements": {"type": "string", "maxLength": 3000},
    "additional_boundaries": {"type": "string", "maxLength": 3000},
    "presence_mode": {"enum": ["EXISTING_ANAM", "CREATE_NEW_ANAM", "STOCK_IMAGE", "TEXT_ONLY"]},
    "knowledge_package_id": {"type": ["string", "null"], "pattern": "^kp-[a-z0-9][a-z0-9-]{2,72}$"},
    "owner_active_input_ms": {"type": "integer", "minimum": 0, "maximum": 86400000},
    "optional_module_ids": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 8,
      "items": {"type": "string", "pattern": "^CMP-[A-Z0-9-]{3,80}$"}
    }
  }
}
