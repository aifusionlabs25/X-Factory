{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aifusionlabs.local/contracts/knowledge_package_manifest.v0.1.schema.json",
  "title": "X-Factory Knowledge Package Manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_id", "label", "status", "created_at", "files", "total_bytes", "authority", "manifest_sha256"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "package_id": {"type": "string", "pattern": "^kp-[a-z0-9][a-z0-9-]{2,72}$"},
    "label": {"type": "string", "minLength": 2, "maxLength": 120},
    "status": {"const": "INGESTED_PENDING_OWNER_APPROVAL"},
    "created_at": {"type": "string", "format": "date-time"},
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stored_name", "original_name", "media_type", "bytes", "sha256"],
        "properties": {
          "stored_name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"},
          "original_name": {"type": "string", "minLength": 1, "maxLength": 120},
          "media_type": {"type": "string", "maxLength": 80},
          "bytes": {"type": "integer", "minimum": 1, "maximum": 262144},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "total_bytes": {"type": "integer", "minimum": 1, "maximum": 524288},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "runtime_truth", "provider_calls", "network_calls", "production_approved"],
      "properties": {
        "source": {"enum": ["OWNER_SUPPLIED_LOCAL_FILES", "OWNER_REQUESTED_PUBLIC_WEBSITE_CAPTURE", "OWNER_REVIEWED_SPECIALIST_DRAFT"]},
        "runtime_truth": {"const": false},
        "provider_calls": {"const": 0},
        "network_calls": {"type": "integer", "minimum": 0, "maximum": 24},
        "production_approved": {"const": false}
      }
    },
    "website_capture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "requested_url", "captured_at", "scope", "max_pages", "pages"],
      "properties": {
        "schema_version": {"const": "0.1"},
        "requested_url": {"type": "string", "pattern": "^https?://", "maxLength": 2048},
        "captured_at": {"type": "string", "format": "date-time"},
        "scope": {"const": "SAME_ORIGIN_PUBLIC_PAGES"},
        "max_pages": {"const": 6},
        "pages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["url", "title", "stored_name", "source_sha256"],
            "properties": {
              "url": {"type": "string", "pattern": "^https?://", "maxLength": 2048},
              "title": {"type": "string", "minLength": 1, "maxLength": 200},
              "stored_name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"},
              "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
            }
          }
        },
        "skipped_pages": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["url", "reason", "source"],
            "properties": {
              "url": {"type": "string", "pattern": "^https?://", "maxLength": 2048},
              "reason": {"enum": ["HTTP_404", "HTTP_410"]},
              "source": {"const": "DISCOVERED_LINK"}
            }
          }
        }
      }
    },
    "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
