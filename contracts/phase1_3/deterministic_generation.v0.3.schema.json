{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aifusionlabs.local/contracts/deterministic_generation.v0.3.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "contract_id", "runtime", "template_engine", "inputs", "origin_policy", "blueprint_field_mappings", "generator_interface", "template_set", "canonical_json", "test_runner", "normalization", "forbidden_nondeterminism", "repeatability"],
  "properties": {
    "schema_version": {"const": "0.3"}, "contract_id": {"const": "CONTRACT-DETERMINISTIC-GENERATION-V3"}, "runtime": {"const": "CPYTHON-3.11-STANDARD-LIBRARY-ONLY"}, "template_engine": {"const": "TYPED_EXACT_TEMPLATE_V3"},
    "inputs": {"const": ["VALIDATED_BLUEPRINT_JSON", "OUTPUT_BUNDLE_MANIFEST_CONTRACT_V3", "VERSIONED_TEMPLATE_SET_V3"]},
    "origin_policy": {"type": "object", "additionalProperties": false, "required": ["allowed_origin_kinds", "precedence", "rule", "prohibited"], "properties": {"allowed_origin_kinds": {"const": ["DIRECT_BLUEPRINT", "DECLARED_FALLBACK", "DECLARED_CONSTANT", "DETERMINISTIC_DERIVATION"]}, "precedence": {"const": ["DIRECT_BLUEPRINT_NONEMPTY", "DECLARED_FALLBACK", "DECLARED_CONSTANT", "DETERMINISTIC_DERIVATION"]}, "rule": {"type": "string", "minLength": 50}, "prohibited": {"const": ["UNDECLARED_SOURCE", "IMPLICIT_DEFAULT", "BUILDER_CHOICE", "PROVIDER_DERIVATION"]}}},
    "blueprint_field_mappings": {"type": "array", "minItems": 19, "maxItems": 19, "items": {"type": "object", "additionalProperties": false, "required": ["output", "origin_kind", "source", "transform", "precedence"], "properties": {"output": {"type": "string"}, "origin_kind": {"enum": ["DIRECT_BLUEPRINT", "DECLARED_FALLBACK", "DECLARED_CONSTANT", "DETERMINISTIC_DERIVATION"]}, "source": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "transform": {"type": "string"}, "precedence": {"type": "integer", "minimum": 1}}}},
    "generator_interface": {"type": "object", "additionalProperties": false, "required": ["module", "command", "callable", "arguments", "preconditions", "exit_codes", "output_boundary", "evidence_boundary"], "properties": {"module": {"const": "x_factory.bundle_generator"}, "command": {"const": "python -m x_factory.bundle_generator generate --blueprint <blueprint.json> --contracts <phase1_3-contract-dir> --output <empty-output-dir> --evidence <empty-run-evidence-dir> --run-label <RUN_1|RUN_2>"}, "callable": {"const": "generate(blueprint_bytes, contract_bytes_by_name, output_dir, evidence_dir, run_label) -> GenerationResult"}, "arguments": {"type": "object", "required": ["blueprint", "contracts", "output", "evidence", "run_label"]}, "preconditions": {"type": "array", "minItems": 4}, "exit_codes": {"type": "object", "required": ["0", "2", "3", "4"]}, "output_boundary": {"const": "WRITE_ONLY_THE_FIVE_MANIFEST_PATHS_BENEATH_RUN_N_OUTPUT"}, "evidence_boundary": {"const": "WRITE_ONLY_EXECUTION_AUDIT_AND_FILE_HASHES_BENEATH_THE_PAIRED_RUN_N_EVIDENCE"}}},
    "template_set": {"type": "object", "additionalProperties": false, "required": ["template_set_id", "template_set_sha256", "hash_rule", "render_order", "placeholder_rules", "definitions"], "properties": {"template_set_id": {"const": "TEMPLATE-SET-SYNTHETIC-BUNDLE-V3"}, "template_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "hash_rule": {"const": "SHA256_OF_CONCATENATED_UTF8_TEMPLATE_ID_NUL_SOURCE_SHA256_LF_RECORDS_SORTED_BY_TEMPLATE_ID"}, "render_order": {"type": "array", "minItems": 5, "maxItems": 5}, "placeholder_rules": {"type": "object"}, "definitions": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "object", "additionalProperties": false, "required": ["template_id", "output_path", "kind", "source_utf8", "source_sha256"], "properties": {"template_id": {"type": "string", "pattern": "^TPL-[A-Z0-9-]+$"}, "output_path": {"type": "string"}, "kind": {"enum": ["MARKDOWN_STRING_TEMPLATE", "JSON_OBJECT_CONSTRUCTOR", "PYTHON_STATIC"]}, "source_utf8": {"type": "string"}, "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}}},
    "canonical_json": {"type": "object", "required": ["encoding", "sort_keys", "indent", "ensure_ascii", "separators", "final_newline", "unicode"]},
    "test_runner": {"type": "object", "required": ["technology", "command", "allowed_imports", "normative_assertions"]}, "normalization": {"type": "object"},
    "forbidden_nondeterminism": {"const": ["CLOCK", "RANDOMNESS", "UNDECLARED_ENVIRONMENT_VARIABLES", "NETWORK", "LOCALE", "HOST_PATHS", "UNORDERED_ITERATION", "PROVIDER_CALLS"]}, "repeatability": {"type": "object"}
  }
}
