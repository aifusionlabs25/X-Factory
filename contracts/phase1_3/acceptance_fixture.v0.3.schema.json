{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://aifusionlabs.local/contracts/acceptance_fixture.v0.3.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "contract_id", "fixture_id", "runner", "path_model", "fixture_process", "environment", "input", "assertions", "evidence_schemas", "evidence_outputs"],
  "properties": {
    "schema_version": {"const": "0.3"}, "contract_id": {"const": "CONTRACT-ACCEPTANCE-FIXTURE-V3"}, "fixture_id": {"const": "FIXTURE-SYNTHETIC-BUNDLE-V3"}, "runner": {"const": "python -m unittest tests.test_bundle -v"},
    "path_model": {"type": "object", "additionalProperties": false, "required": ["base", "generator_roots", "test_runner_evidence_root", "path_interpretation", "ownership"], "properties": {"base": {"const": "EPHEMERAL_FIXTURE_ROOT"}, "generator_roots": {"type": "object", "required": ["RUN_1_OUTPUT", "RUN_1_EVIDENCE", "RUN_2_OUTPUT", "RUN_2_EVIDENCE"]}, "test_runner_evidence_root": {"const": "fixture-evidence"}, "path_interpretation": {"const": "ALL_EVIDENCE_OUTPUT_PATHS_ARE_RELATIVE_TO_EPHEMERAL_FIXTURE_ROOT"}, "ownership": {"type": "string"}}},
    "fixture_process": {"type": "object", "required": ["steps", "generator_command_source", "process_boundary", "failure_rule"]}, "environment": {"type": "object"}, "input": {"type": "object"},
    "assertions": {"type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["id", "procedure", "pass_condition", "evidence"], "properties": {"id": {"pattern": "^ASSERT-00[1-6]$"}, "procedure": {"type": "string"}, "pass_condition": {"type": "string"}, "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}}}},
    "evidence_schemas": {"type": "object", "additionalProperties": false, "required": ["EXECUTION_AUDIT_V3", "FILE_HASHES_V3", "REPEATABILITY_REPORT_V3", "TEST_RESULTS_V3"], "properties": {"EXECUTION_AUDIT_V3": {"type": "object", "required": ["$schema", "type", "additionalProperties", "required", "properties"]}, "FILE_HASHES_V3": {"type": "object", "required": ["$schema", "type", "additionalProperties", "required", "properties"]}, "REPEATABILITY_REPORT_V3": {"type": "object", "required": ["$schema", "type", "additionalProperties", "required", "properties"]}, "TEST_RESULTS_V3": {"type": "object", "required": ["$schema", "type", "additionalProperties", "required", "properties"]}}},
    "evidence_outputs": {"type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["path", "producer", "run_label", "schema_ref", "write_timing"], "properties": {"path": {"type": "string"}, "producer": {"enum": ["GENERATOR", "TEST_RUNNER"]}, "run_label": {"enum": ["RUN_1", "RUN_2", "BOTH"]}, "schema_ref": {"enum": ["EXECUTION_AUDIT_V3", "FILE_HASHES_V3", "REPEATABILITY_REPORT_V3", "TEST_RESULTS_V3"]}, "write_timing": {"type": "string"}}}}
  }
}
