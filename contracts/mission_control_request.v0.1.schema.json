{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aifusionlabs.local/contracts/mission_control_request.v0.1.schema.json",
  "title": "X-Factory Mission Control Request v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["purpose", "agent_or_client", "personality", "must_accomplish", "never_do", "presence_mode"],
  "properties": {
    "prepared_agent": {"type":"object","additionalProperties":false,"required":["project_id","package_sha256"],"properties":{"project_id":{"type":"string","pattern":"^project-[a-f0-9]{24}$"},"package_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}}},
    "purpose": {"type": "string", "minLength": 10, "maxLength": 2000},
    "agent_or_client": {"type": "string", "minLength": 2, "maxLength": 160},
    "x_agent_name": {"type": ["string", "null"], "minLength": 2, "maxLength": 80},
    "client_name": {"type": ["string", "null"], "minLength": 2, "maxLength": 160},
    "role_title": {"type": ["string", "null"], "minLength": 2, "maxLength": 160},
    "public_role_title": {"type": ["string", "null"], "minLength": 2, "maxLength": 160},
    "chassis_role_title": {"type": ["string", "null"], "minLength": 2, "maxLength": 160},
    "chassis_id": {"type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "chassis_version": {"type": ["string", "null"], "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "chassis_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "client_context": {"type": ["string", "null"], "maxLength": 4000},
    "personality": {"type": "string", "minLength": 2, "maxLength": 1000},
    "must_accomplish": {"type": "string", "minLength": 2, "maxLength": 3000},
    "never_do": {"type": "string", "minLength": 2, "maxLength": 3000},
    "target_users": {"type": "string", "maxLength": 1000},
    "output_artifact": {"type": "string", "maxLength": 500},
    "presence_mode": {"enum": ["EXISTING_ANAM", "CREATE_NEW_ANAM", "STOCK_IMAGE", "TEXT_ONLY"]},
    "persona_catalog_id": {"type": ["string", "null"], "maxLength": 160},
    "selected_optional_modules": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 8,
      "items": {"type": "string", "pattern": "^CMP-[A-Z0-9-]{3,80}$"}
    },
    "owner_active_input_ms": {"type": ["integer", "null"], "minimum": 0, "maximum": 86400000},
    "knowledge_package": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["package_id", "label", "manifest_sha256", "approval_sha256", "status", "files", "total_bytes", "compilation_id", "compilation_sha256", "review_id", "review_sha256", "approved_entries"],
      "properties": {
        "package_id": {"type": "string", "pattern": "^kp-[a-z0-9][a-z0-9-]{2,72}$"},
        "label": {"type": "string", "minLength": 2, "maxLength": 120},
        "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "approval_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "status": {"const": "OWNER_APPROVED_FOR_COMMISSIONING"},
        "files": {"type": "integer", "minimum": 1, "maximum": 8},
        "total_bytes": {"type": "integer", "minimum": 1, "maximum": 524288},
        "compilation_id": {"type": "string", "pattern": "^kc-[a-z0-9][a-z0-9-]{2,72}$"},
        "compilation_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "review_id": {"type": "string", "pattern": "^kr-[a-z0-9][a-z0-9-]{2,72}$"},
        "review_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "approved_entries": {"type": "integer", "minimum": 1, "maximum": 200}
      }
    }
  }
}
